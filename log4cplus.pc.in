prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
modules=

Name: log4cplus
Version: @VERSION@
Description: Simple to use, thread-safe C++ logging API
Requires:
Requires.private: @LOG4CPLUS_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -l@LOG4CPLUS_PC_LIBRARY@
Libs.private: @LIBS@
Cflags: -I${includedir}@LOG4CPLUS_PC_CPPFLAGS@
