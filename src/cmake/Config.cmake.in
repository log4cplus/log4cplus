include(CMakeFindDependencyMacro)

if (@LOG4CPLUS_CONFIG_FIND_THREADS@)
  find_dependency(Threads)
endif ()

if (@LOG4CPLUS_WITH_SYSTEMD@ AND NOT @BUILD_SHARED_LIBS@)
  find_dependency(PkgConfig)
  pkg_check_modules(LOG4CPLUS_SYSTEMD QUIET IMPORTED_TARGET libsystemd)
  if (NOT LOG4CPLUS_SYSTEMD_FOUND)
    set(log4cplus_FOUND FALSE)
    set(log4cplus_NOT_FOUND_MESSAGE "The static log4cplus library requires libsystemd, but pkg-config could not find it.")
    return()
  endif ()
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/@targets_export_name@.cmake")

# Static and Unicode library file names can be decorated. Keep their imported
# target names for compatibility while also providing the canonical target
# used by source-tree consumers and shared installations.
if (@LOG4CPLUS_CONFIG_ADD_CANONICAL_TARGET@
    AND NOT TARGET log4cplus::log4cplus)
  add_library(log4cplus::log4cplus INTERFACE IMPORTED)
  set_property(TARGET log4cplus::log4cplus PROPERTY
    INTERFACE_LINK_LIBRARIES log4cplus::@log4cplus@)
endif ()
